# Zoid backend — Docker environment file.
# Copy values from .env.example and fill in real credentials.
# All secrets here are used for development mode
# --- Application ---
APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL) ---
# This is overridden by docker-compose.yml, but included for completeness
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/zoid  # development
DB_ECHO=false

# --- Provider selection ---
PAYMENT_PROVIDER=paystack
EMAIL_PROVIDER=resend
STORAGE_PROVIDER=cloudinary
AUTH_SESSION_STRATEGY=jwt_cookie

# --- Auth / sessions ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=10080
COOKIE_NAME=app_session_id
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# --- Payment providers ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=NGN
PAYMENT_RETURN_URL=http://localhost:5173/checkout

# --- Email ---
RESEND_API_KEY=
STORE_OWNER_EMAIL=owner@example.com
EMAIL_FROM=noreply@example.com

# --- Storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting / Redis ---
# This is overridden by docker-compose.yml, but included for completeness
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
