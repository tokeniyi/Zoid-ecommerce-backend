# Zoid backend — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_ENV=development
DEBUG=true

# --- Database (PostgreSQL via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zoid
# Log every SQL statement (development only).
DB_ECHO=false

# --- Provider selection (configuration-driven) ---
PAYMENT_PROVIDER=paystack
EMAIL_PROVIDER=resend
STORAGE_PROVIDER=cloudinary
AUTH_SESSION_STRATEGY=jwt_cookie

# --- Auth / sessions ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=10080
COOKIE_NAME=app_session_id
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# --- Payment providers ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=NGN
# Where the provider's hosted checkout returns the customer to
PAYMENT_RETURN_URL=http://localhost:5173/checkout

# --- Email ---
RESEND_API_KEY=
STORE_OWNER_EMAIL=owner@example.com
EMAIL_FROM=noreply@example.com

# --- Storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Blank endpoint means real Amazon S3; set it for any S3-compatible service.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting / Redis ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
